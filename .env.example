# Copy to .env and fill in to run the app fully live with a real data provider.
# Without these set, the app runs with the NullProvider and reports market data
# as "unavailable" rather than fabricating values.

# Set to "http" (or "live") to enable live HTTP fetching.
CIT_DATA_PROVIDER=http

# Endpoints returning real data in the JSON shapes documented in
# car_investment_tracker/services/providers/http_provider.py
CIT_HISTORICAL_API_URL=https://your-feed.example/historical
CIT_LISTINGS_API_URL=https://your-feed.example/listings
CIT_DISCUSSIONS_API_URL=https://your-feed.example/discussions

# Optional bearer token sent as the Authorization header to every endpoint.
CIT_DATA_API_KEY=

# Optional per-request timeout in seconds (default: 8).
CIT_DATA_TIMEOUT=8

# Port the server binds to (most platforms set this automatically).
PORT=8000
